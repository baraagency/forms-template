# Required for embedded FUB context verification (real logic, not mocked)
FUB_SECRET_KEY=dev-secret-for-local-testing

# Postgres connection string (required for bun run db:migrations and /forms/settings)
DATABASE_URL=postgres://localhost:5432/fub_forms

# Optional: enable debug panel on /forms/submitted
ENVIRONMENT=LOCAL

# Optional: live SISU team-fields for /forms/settings mappings (falls back to fixture when unset)
# SISU_API_KEY=
# SISU_API_URL=https://api.sisu.co/api

# Optional: live FUB people (allFields) for /forms/settings person field options
# FUB_API_KEY=
# FUB_X_SYSTEM=
# FUB_X_SYSTEM_KEY=
# FUB_API_URL=https://api.followupboss.com/v1

# Optional: Gmail OAuth for /forms/settings submission email
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/forms/settings/gmail/oauth/callback
# APP_BASE_URL=http://localhost:3000

# Generate a signed /forms test URL:
# bun run dev:fub-context

# Template fixture IDs (used in mock API responses):
# Person 123, Agent 1, Deal 456, SISU transaction 789
# Example pending URL:
# /forms/pending?clientId=123&agentId=1&dealId=456&sisuTransactionId=789&clientName=Jane+Client
